# ═══════════════════════════════════════════
#  ZONA OESTE ROLEPLAY — Environment Variables
#  Copie para .env.local e preencha os valores
# ═══════════════════════════════════════════

# ── Discord ──
NEXT_PUBLIC_DISCORD_URL=

# ── Conexão do servidor (FiveM) ──
NEXT_PUBLIC_CONNECT_URL=

# ── Loja VIP ──
NEXT_PUBLIC_STORE_URL=

# ── Redes Sociais ──
NEXT_PUBLIC_TIKTOK_URL=

# ── API do servidor (endpoint de status) ──
NEXT_PUBLIC_SERVER_API=/api/server
